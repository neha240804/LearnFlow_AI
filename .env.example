# ─────────────────────────────────────────────────────────────
# LearnFlow AI — Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── AI Providers ─────────────────────────────────────────────
# Groq API key — used for fast LLM inference (llama-3 models)
# Get one free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth ─────────────────────────────────────────────────────
# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_64_char_random_hex_string

# ── App ───────────────────────────────────────────────────────
APP_URL=http://localhost:3000
