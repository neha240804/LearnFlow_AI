import React, { useState, useEffect } from 'react';
import axios from 'axios';
import {
  Sparkles, Flame, Star, Trophy, BookOpen, Layers, Users, LogOut, Compass,
  Settings, Medal, Play, Lock, FileText, ChevronRight, ArrowLeft, ArrowRight,
  CheckCircle2, HelpCircle, Upload, Award, AlertCircle, RefreshCw, Clock, Check
} from 'lucide-react';

import { Navigation } from './components/Navigation';
import { MetricRing } from './components/MetricRing';
import { TopicSearchCard } from './components/TopicSearchCard';
import { Leaderboard } from './components/Leaderboard';
import { LearningJourney } from './components/LearningJourney';
import { LessonVisualizer } from './components/LessonVisualizer';
import { QuizSection } from './components/QuizSection';
import { FlashcardSet } from './components/FlashcardSet';
import { User, Topic, Concept, Lesson, Flashcard, Question, ConceptProgress, DashboardStats, TeacherDashboardStats } from './types';

export default function App() {
  const [user, setUser] = useState<User | null>(null);
  const [view, setView] = useState<string>('landing');
  
  // Auth Form State
  const [authEmail, setAuthEmail] = useState('');
  const [authPassword, setAuthPassword] = useState('');
  const [authName, setAuthName] = useState('');
  const [authRole, setAuthRole] = useState<'student' | 'teacher'>('student');
  const [authError, setAuthError] = useState<string | null>(null);

  // Core Data State
  const [topics, setTopics] = useState<Topic[]>([]);
  const [selectedTopic, setSelectedTopic] = useState<Topic | null>(null);
  const [selectedConcept, setSelectedConcept] = useState<Concept | null>(null);
  const [conceptContent, setConceptContent] = useState<{
    concept: Concept;
    lesson: Lesson;
    flashcards: Flashcard[];
    questions: Question[];
    progress: ConceptProgress | null;
  } | null>(null);

  // Student Dashboard Stats
  const [dashboardStats, setDashboardStats] = useState<DashboardStats | null>(null);

  // Teacher Dashboard Stats
  const [teacherStats, setTeacherStats] = useState<TeacherDashboardStats | null>(null);
  const [teacherCourseTitle, setTeacherCourseTitle] = useState('');
  const [teacherCourseSubject, setTeacherCourseSubject] = useState('Physics');
  const [teacherSyllabus, setTeacherSyllabus] = useState('');
  const [teacherIsGenerating, setTeacherIsGenerating] = useState(false);

  // Toast State
  const [toast, setToast] = useState<{ message: string; type: 'success' | 'error' | 'info' } | null>(null);

  // Load Session on Mount
  useEffect(() => {
    const savedUser = localStorage.getItem('learnflow_user');
    if (savedUser) {
      const u = JSON.parse(savedUser) as User;
      setUser(u);
      setView('dashboard');
    }
  }, []);

  // Fetch Dashboard Stats and Topics when User/View changes
  useEffect(() => {
    if (!user) return;

    if (view === 'dashboard') {
      fetchTopics();
      fetchDashboardStats();
    } else if (view === 'teacher' && user.role === 'teacher') {
      fetchTeacherAnalytics();
    }
  }, [user, view]);

  // Toast Helper
  const triggerToast = (message: string, type: 'success' | 'error' | 'info' = 'success') => {
    setToast({ message, type });
    setTimeout(() => setToast(null), 4000);
  };

  const fetchTopics = async () => {
    try {
      const res = await axios.get(`/api/topics?userId=${user?.id}`);
      setTopics(res.data.topics);
    } catch (err) {
      console.error("Failed to fetch topics", err);
    }
  };

  const fetchDashboardStats = async () => {
    try {
      const res = await axios.get(`/api/dashboard?userId=${user?.id}`);
      setDashboardStats(res.data);
    } catch (err) {
      console.error("Failed to fetch dashboard stats", err);
    }
  };

  const fetchTeacherAnalytics = async () => {
    try {
      const res = await axios.get('/api/teacher/analytics');
      setTeacherStats(res.data);
    } catch (err) {
      console.error("Failed to fetch teacher stats", err);
    }
  };

  // Auth Handlers
  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!authEmail) {
      setAuthError("Email is required.");
      return;
    }
    setAuthError(null);
    try {
      const res = await axios.post('/api/auth/login', {
        email: authEmail,
        password: authPassword
      });
      setUser(res.data.user);
      localStorage.setItem('learnflow_user', JSON.stringify(res.data.user));
      setView('dashboard');
      triggerToast(`Welcome back, ${res.data.user.name}!`, 'success');
    } catch (err: any) {
      setAuthError(err.response?.data?.error || "Login failed.");
    }
  };

  const handleRegister = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!authName || !authEmail) {
      setAuthError("Name and email are required.");
      return;
    }
    setAuthError(null);
    try {
      const res = await axios.post('/api/auth/register', {
        name: authName,
        email: authEmail,
        role: authRole
      });
      setUser(res.data.user);
      localStorage.setItem('learnflow_user', JSON.stringify(res.data.user));
      setView('dashboard');
      triggerToast(`Account created successfully! Welcome to LearnFlow AI.`, 'success');
    } catch (err: any) {
      setAuthError(err.response?.data?.error || "Registration failed.");
    }
  };

  const handleDemoStudentLogin = () => {
    setAuthEmail('student@learnflow.ai');
    setAuthPassword('demo');
    // Call API direct or fake auth login
    axios.post('/api/auth/login', {
      email: 'student@learnflow.ai',
      password: 'demo'
    }).then(res => {
      setUser(res.data.user);
      localStorage.setItem('learnflow_user', JSON.stringify(res.data.user));
      setView('dashboard');
      triggerToast(`Logged in as Alex Mercer (Demo student)`, 'success');
    }).catch(err => {
      console.error(err);
    });
  };

  const handleLogout = () => {
    localStorage.removeItem('learnflow_user');
    setUser(null);
    setView('landing');
    setSelectedTopic(null);
    setSelectedConcept(null);
    setConceptContent(null);
    triggerToast("Logged out successfully.", "info");
  };

  // Toggle role in sandbox
  const handleToggleRole = () => {
    if (!user) return;
    const newRole = user.role === 'student' ? 'teacher' : 'student';
    // Modifies in-memory/DB & state
    const updatedUser = { ...user, role: newRole };
    setUser(updatedUser);
    localStorage.setItem('learnflow_user', JSON.stringify(updatedUser));
    // Let's call register/me or let the database handle it
    axios.post('/api/auth/register', {
      name: user.name,
      email: user.email,
      role: newRole
    }).then(() => {
      triggerToast(`Testing Mode: Swapped view to ${newRole.toUpperCase()} dashboard.`, 'info');
      setView(newRole === 'teacher' ? 'teacher' : 'dashboard');
    }).catch(() => {
      triggerToast(`Testing Mode: Swapped view to ${newRole.toUpperCase()} dashboard.`, 'info');
      setView(newRole === 'teacher' ? 'teacher' : 'dashboard');
    });
  };

  // Reset database sandbox
  const handleResetDB = async () => {
    try {
      await axios.post('/api/admin/reset');
      triggerToast("Database restored successfully to seed state.", 'success');
      fetchTopics();
      fetchDashboardStats();
      if (view === 'teacher') fetchTeacherAnalytics();
      setSelectedTopic(null);
      setSelectedConcept(null);
      setConceptContent(null);
    } catch (err) {
      triggerToast("Failed to reset database", 'error');
    }
  };

  // Topic Roadmap generation from bento cards
  const handleGenerateCustomTopic = async (topicTitle: string, notesText?: string) => {
    try {
      const res = await axios.post('/api/topics/create', {
        topicTitle,
        subject: 'STEM Course',
        notesText,
        userId: user?.id
      });
      triggerToast(`Adaptive roadmap generated for "${topicTitle}"!`, 'success');
      await fetchTopics();
      // Auto open course roadmap
      const topicId = res.data.topic.id;
      const t = topics.find(tp => tp.id === topicId) || res.data.topic;
      setSelectedTopic(t);
      setView('journey');
    } catch (err: any) {
      throw new Error(err.response?.data?.error || "AI mapping error.");
    }
  };

  // Course generation panel inside teacher desk
  const handleTeacherGenerateCourse = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!teacherCourseTitle) {
      triggerToast("Please specify a course title", "error");
      return;
    }
    setTeacherIsGenerating(true);
    try {
      await axios.post('/api/topics/create', {
        topicTitle: teacherCourseTitle,
        subject: teacherCourseSubject,
        notesText: teacherSyllabus || undefined,
        userId: user?.id
      });
      triggerToast(`Course "${teacherCourseTitle}" compiled successfully!`, 'success');
      setTeacherCourseTitle('');
      setTeacherSyllabus('');
      fetchTeacherAnalytics();
    } catch (err: any) {
      triggerToast(err.response?.data?.error || "Course compilation failed.", 'error');
    } finally {
      setTeacherIsGenerating(false);
    }
  };

  // Opening learning content
  const handleOpenConcept = async (conceptId: string, actionView: 'lesson' | 'quiz') => {
    const concept = selectedTopic?.concepts?.find(c => c.id === conceptId);
    if (!concept && selectedTopic) {
      // Find concept in topics
      const c = selectedTopic.concepts?.find(item => item.id === conceptId);
      if (c) setSelectedConcept(c);
    } else if (concept) {
      setSelectedConcept(concept);
    }

    try {
      const res = await axios.get(`/api/concepts/${conceptId}/content?userId=${user?.id}`);
      setConceptContent(res.data);
      setView(actionView);
    } catch (err) {
      triggerToast("Failed to load concept lessons.", "error");
    }
  };

  // Quiz grading adaptive submission
  const handleQuizSubmit = async (accuracy: number, confidence: 'low' | 'medium' | 'high', responseTimeSec: number) => {
    if (!selectedConcept) return;
    try {
      const res = await axios.post('/api/quiz/submit', {
        userId: user?.id,
        conceptId: selectedConcept.id,
        accuracy,
        confidence,
        responseTimeSec
      });
      triggerToast(`Quiz graded! You earned +${res.data.xpEarned} XP.`, 'success');
      
      // Update local profile stats if streak or badges updated
      if (user) {
        setUser({
          ...user,
          xp: user.xp + res.data.xpEarned,
          badges: res.data.newBadges
        });
      }

      // Re-fetch concept content to load updated mastery status
      const contentRes = await axios.get(`/api/concepts/${selectedConcept.id}/content?userId=${user?.id}`);
      setConceptContent(contentRes.data);

      // Return to journey map
      setView('journey');
      fetchTopics();
      fetchDashboardStats();
    } catch (err) {
      triggerToast("Failed to submit diagnostic quiz results.", "error");
    }
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 flex flex-col font-sans relative overflow-x-hidden antialiased">
      
      {/* Background soft ambient grids */}
      <div className="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-indigo-500/5 rounded-full blur-[120px] pointer-events-none" />
      <div className="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-violet-500/5 rounded-full blur-[120px] pointer-events-none" />

      {/* Floating Vibrant Palette Toast */}
      {toast && (
        <div className={`fixed bottom-5 right-5 px-6 py-4 rounded-2xl border shadow-xl z-[9999] transition-all duration-300 flex items-center gap-3 animate-fade-in ${
          toast.type === 'success' 
            ? 'border-emerald-200 bg-emerald-50 text-emerald-800' 
            : toast.type === 'error' 
            ? 'border-red-200 bg-red-50 text-red-800' 
            : 'border-indigo-200 bg-indigo-50 text-indigo-800'
        }`}>
          <div className="p-1 rounded-full bg-white/40">
            {toast.type === 'success' ? <CheckCircle2 className="w-5 h-5 text-emerald-600" /> : <AlertCircle className="w-5 h-5 text-red-600" />}
          </div>
          <span className="text-sm font-bold tracking-wide">{toast.message}</span>
        </div>
      )}

      {/* Navigation Rail */}
      <Navigation
        user={user}
        activeTab={view === 'teacher' ? 'teacher' : view === 'profile' ? 'profile' : 'dashboard'}
        onChangeTab={(tab) => {
          setView(tab);
          setSelectedTopic(null);
        }}
        onLogout={handleLogout}
        onToggleRole={handleToggleRole}
        onResetDB={handleResetDB}
      />

      <main className="flex-grow flex flex-col">
        
        {/* ==========================================
            VIEW: LANDING PAGE
            ========================================== */}
        {view === 'landing' && (
          <div className="flex-grow flex flex-col justify-center max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20 relative">
            
            {/* Hero Column */}
            <div className="text-center max-w-4xl mx-auto space-y-6 pt-10">
              <div className="inline-flex items-center gap-2 px-3.5 py-1 bg-indigo-50 border border-indigo-100 text-indigo-700 rounded-full text-xs font-mono tracking-wider uppercase shadow-sm shadow-indigo-100/5 animate-pulse">
                <Sparkles className="w-4 h-4 text-indigo-600" />
                <span>Next-Generation Adaptive STEM Tutor</span>
              </div>

              <h1 className="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight leading-[1.1] text-slate-900">
                Learn STEM on an <span className="bg-gradient-to-r from-indigo-600 via-violet-600 to-indigo-700 bg-clip-text text-transparent">Adaptive Flow</span>
              </h1>

              <p className="text-base sm:text-xl text-slate-500 max-w-2xl mx-auto leading-relaxed">
                LearnFlow AI behaves like a world-class personal teacher. It maps dynamic roadmaps, analyzes learning gaps with diagnostic quizzes, and generates personalized micro lessons for weak concepts.
              </p>

              {/* CTAs */}
              <div className="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
                <button
                  id="btn-landing-try-demo"
                  onClick={handleDemoStudentLogin}
                  className="w-full sm:w-auto px-8 py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl transition-all shadow-xl shadow-indigo-100 flex items-center justify-center gap-2 cursor-pointer"
                >
                  <Play className="w-4.5 h-4.5 fill-white" />
                  <span>Try as Demo Student</span>
                </button>

                <button
                  id="btn-landing-register"
                  onClick={() => setView('register')}
                  className="w-full sm:w-auto px-8 py-4 bg-white border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold rounded-2xl transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span>Create Account</span>
                </button>

                <button
                  id="btn-landing-login"
                  onClick={() => setView('login')}
                  className="w-full sm:w-auto px-6 py-4 text-xs font-bold tracking-wider text-indigo-600 hover:text-indigo-800 font-mono uppercase cursor-pointer"
                >
                  Sign In
                </button>
              </div>
            </div>

            {/* Visual Bento Grid Concept */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
              
              <div className="p-6 rounded-3xl border border-slate-200 bg-white shadow-md space-y-3">
                <div className="p-2.5 bg-indigo-50 text-indigo-600 rounded-xl w-fit">
                  <Flame className="w-5 h-5" />
                </div>
                <h3 className="text-lg font-bold text-slate-900">Adaptive Mastery Engine</h3>
                <p className="text-xs text-slate-500 leading-relaxed">
                  Instead of showing endless static chapters, we track accuracy, response speed, and confidence. Score below 40%? The lesson repeats with easier terms.
                </p>
              </div>

              <div className="p-6 rounded-3xl border border-slate-200 bg-white shadow-md space-y-3">
                <div className="p-2.5 bg-violet-50 text-violet-600 rounded-xl w-fit">
                  <FileText className="w-5 h-5" />
                </div>
                <h3 className="text-lg font-bold text-slate-900">PDF & Notes Ingestion</h3>
                <p className="text-xs text-slate-500 leading-relaxed">
                  Upload PDF lecture notes or textbook files. Gemini will extract content, build a custom roadmap, and generate lessons directly referencing your documents.
                </p>
              </div>

              <div className="p-6 rounded-3xl border border-slate-200 bg-white shadow-md space-y-3">
                <div className="p-2.5 bg-emerald-50 text-emerald-600 rounded-xl w-fit">
                  <BookOpen className="w-5 h-5" />
                </div>
                <h3 className="text-lg font-bold text-slate-900">Infinite Mapped Subjects</h3>
                <p className="text-xs text-slate-500 leading-relaxed">
                  Physics, Matrices, Chemistry, Neural Networks, Thermodynamics, Electrical Circuits. Type any subject, and your personalized STEM course generates instantly.
                </p>
              </div>

            </div>

          </div>
        )}

        {/* ==========================================
            VIEW: REGISTER PAGE
            ========================================== */}
        {view === 'register' && (
          <div className="flex-grow flex items-center justify-center px-4 py-16">
            <div className="w-full max-w-md p-8 rounded-3xl border border-slate-200 bg-white shadow-xl space-y-6">
              
              <button
                onClick={() => setView('landing')}
                className="flex items-center gap-1.5 text-xs font-mono text-slate-500 hover:text-slate-800 uppercase tracking-wider transition-all cursor-pointer"
              >
                <ArrowLeft className="w-4 h-4" />
                <span>Back to landing</span>
              </button>

              <div className="space-y-1">
                <h2 className="text-2xl font-black text-slate-900 tracking-wide">Get Started</h2>
                <p className="text-xs text-slate-500">Join LearnFlow AI and start your adaptive STEM journey.</p>
              </div>

              {authError && (
                <div className="p-3 bg-rose-50 border border-rose-100 rounded-xl text-xs text-rose-700">
                  {authError}
                </div>
              )}

              <form onSubmit={handleRegister} className="space-y-4">
                <div className="space-y-1.5">
                  <label className="text-xs font-mono text-slate-500 uppercase tracking-wider block">FullName</label>
                  <input
                    type="text"
                    required
                    placeholder="Alex Mercer"
                    value={authName}
                    onChange={e => setAuthName(e.target.value)}
                    className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:border-indigo-500 focus:bg-white focus:outline-none transition-all text-slate-950"
                  />
                </div>

                <div className="space-y-1.5">
                  <label className="text-xs font-mono text-slate-500 uppercase tracking-wider block">Email Address</label>
                  <input
                    type="email"
                    required
                    placeholder="student@learnflow.ai"
                    value={authEmail}
                    onChange={e => setAuthEmail(e.target.value)}
                    className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:border-indigo-500 focus:bg-white focus:outline-none transition-all text-slate-950"
                  />
                </div>

                <div className="space-y-1.5">
                  <label className="text-xs font-mono text-slate-500 uppercase tracking-wider block">Select Account Role</label>
                  <div className="grid grid-cols-2 gap-2 bg-slate-100 p-1 rounded-xl border border-slate-200">
                    <button
                      type="button"
                      onClick={() => setAuthRole('student')}
                      className={`py-2 text-xs font-medium rounded-lg transition-all cursor-pointer ${
                        authRole === 'student'
                          ? 'bg-indigo-600 text-white font-bold'
                          : 'text-slate-500 hover:text-slate-800'
                      }`}
                    >
                      Student Account
                    </button>
                    <button
                      type="button"
                      onClick={() => setAuthRole('teacher')}
                      className={`py-2 text-xs font-medium rounded-lg transition-all cursor-pointer ${
                        authRole === 'teacher'
                          ? 'bg-indigo-600 text-white font-bold'
                          : 'text-slate-500 hover:text-slate-800'
                      }`}
                    >
                      Teacher Desk
                    </button>
                  </div>
                </div>

                <button
                  id="btn-submit-register"
                  type="submit"
                  className="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl transition-all shadow-lg text-sm cursor-pointer"
                >
                  Create Account
                </button>
              </form>

              <p className="text-xs text-center text-slate-500 font-sans">
                Already have an account?{' '}
                <button onClick={() => setView('login')} className="text-indigo-600 hover:underline font-bold cursor-pointer bg-transparent">
                  Sign In
                </button>
              </p>

            </div>
          </div>
        )}

        {/* ==========================================
            VIEW: LOGIN PAGE
            ========================================== */}
        {view === 'login' && (
          <div className="flex-grow flex items-center justify-center px-4 py-16">
            <div className="w-full max-w-md p-8 rounded-3xl border border-slate-200 bg-white shadow-xl space-y-6">
              
              <button
                onClick={() => setView('landing')}
                className="flex items-center gap-1.5 text-xs font-mono text-slate-500 hover:text-slate-800 uppercase tracking-wider transition-all cursor-pointer"
              >
                <ArrowLeft className="w-4 h-4" />
                <span>Back to landing</span>
              </button>

              <div className="space-y-1">
                <h2 className="text-2xl font-black text-slate-900 tracking-wide">Welcome Back</h2>
                <p className="text-xs text-slate-500">Sign in to your LearnFlow personal STEM portal.</p>
              </div>

              {authError && (
                <div className="p-3 bg-rose-50 border border-rose-100 rounded-xl text-xs text-rose-700">
                  {authError}
                </div>
              )}

              <form onSubmit={handleLogin} className="space-y-4">
                <div className="space-y-1.5">
                  <label className="text-xs font-mono text-slate-500 uppercase tracking-wider block">Email Address</label>
                  <input
                    type="email"
                    required
                    placeholder="student@learnflow.ai"
                    value={authEmail}
                    onChange={e => setAuthEmail(e.target.value)}
                    className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:border-indigo-500 focus:bg-white focus:outline-none transition-all text-slate-950"
                  />
                </div>

                <div className="space-y-1.5">
                  <div className="flex items-center justify-between">
                    <label className="text-xs font-mono text-slate-500 uppercase tracking-wider">Password</label>
                    <button
                      type="button"
                      onClick={() => setView('forgot')}
                      className="text-[10px] text-indigo-600 hover:underline font-mono uppercase font-bold cursor-pointer"
                    >
                      Forgot?
                    </button>
                  </div>
                  <input
                    type="password"
                    placeholder="••••••••"
                    value={authPassword}
                    onChange={e => setAuthPassword(e.target.value)}
                    className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:border-indigo-500 focus:bg-white focus:outline-none transition-all text-slate-950"
                  />
                </div>

                <button
                  id="btn-submit-login"
                  type="submit"
                  className="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl transition-all shadow-lg text-sm cursor-pointer"
                >
                  Sign In
                </button>
              </form>

              <div className="relative flex py-2 items-center">
                <div className="flex-grow border-t border-slate-200"></div>
                <span className="flex-shrink mx-4 text-[10px] text-slate-400 font-mono uppercase">OR TEST AS DEMO</span>
                <div className="flex-grow border-t border-slate-200"></div>
              </div>

              <button
                id="btn-demo-quick-login"
                onClick={handleDemoStudentLogin}
                className="w-full py-3 bg-indigo-50 border border-indigo-100 text-indigo-700 rounded-xl hover:bg-indigo-100/50 transition-all font-semibold text-xs uppercase font-mono shadow-sm cursor-pointer"
              >
                Instant Student Access (student@learnflow.ai)
              </button>

              <p className="text-xs text-center text-slate-500 font-sans">
                Don't have an account?{' '}
                <button onClick={() => setView('register')} className="text-indigo-600 hover:underline font-bold cursor-pointer">
                  Register
                </button>
              </p>

            </div>
          </div>
        )}

        {/* ==========================================
            VIEW: FORGOT PASSWORD PAGE
            ========================================== */}
        {view === 'forgot' && (
